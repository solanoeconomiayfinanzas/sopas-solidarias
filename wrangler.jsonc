{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sopas-solidarias",
  "main": "src/worker.js",
  "compatibility_date": "2024-10-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sopas-db",
      "database_id": "d2bad1c0-a50c-4e11-bffb-5c260da062d9"
    }
  ],
  "observability": {
    "enabled": true
  }
}
